# =============================================================================
# DJANGO CORE
# =============================================================================

# Kunci rahasia Django untuk signing session, CSRF token, dll.
SECRET_KEY=dev-secret-key-change-me
# Mode debug (True=aktif, False=produksi). Jangan True di production!
DEBUG=False

# =============================================================================
# DATABASE - PostgreSQL
# =============================================================================

DATABASE_NAME=database
DATABASE_USER=postgres
DATABASE_PASSWORD=fairyBuster555.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_SSLMODE=disable

# =============================================================================
# DOMAIN APLIKASI & ACME (SSL)
# =============================================================================

# Domain utama aplikasi, digunakan untuk URL callback notifikasi Jayapay
APP_DOMAIN=mayaclouder.online
# Email untuk registrasi sertifikat SSL (Let's Encrypt / ACME)
ACME_EMAIL=admin@mayaclouder.online

# =============================================================================
# INTEGRASI JAYAPAY - Payment Gateway
# =============================================================================

# Aktifkan/nonaktifkan integrasi Jayapay (True/False)
JAYAPAY_ENABLED=True
# Kode merchant dari Jayapay
JAYAPAY_MERCHANT_CODE=S820240719085318000011
# Private key RSA untuk signing request ke Jayapay (isi key saja, tanpa header/footer PEM)
JAYAPAY_PRIVATE_KEY=""
# Public key RSA dari Jayapay untuk verifikasi signature response/callback
JAYAPAY_PUBLIC_KEY="MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCQuQJP0VYOZ5hZq3hDHPqx9L3JHtJ8gx4nDspttjqwId0rZVrdpW2aAm9rA11UBlCxR15FhaW9IQ9lKWG1kG+Nusc56CrRyOHMqURN+PwwhGuF2JTQT8c3ey8hq9W/kkD8mu3RAaqNZHpDClaCLabTdcN157h64R6WRtsPW883sQIDAQAB"

# =============================================================================
# PENGATURAN KEAMANAN - Pembatasan Domain & IP (DomainIPSecurityMiddleware)
# =============================================================================
# Middleware: config.security_middleware.DomainIPSecurityMiddleware
# Fungsi: Memblokir request dari domain/IP yang TIDAK ada di daftar di bawah.
# True  = bypass / lewati pengecekan (semua IP/domain bisa akses, untuk development)
# False = aktifkan pembatasan (hanya IP/domain terdaftar yang bisa akses, untuk production)
BYPASS_DOMAIN_IP_SECURITY=False

# Domain yang diizinkan mengakses API (mendukung wildcard *.domain.com)
# Dipisahkan dengan koma. Port opsional (contoh: localhost:8000).

# =============================================================================
# CORS - Cross-Origin Resource Sharing (django-cors-headers)
# =============================================================================
# True  = izinkan SEMUA origin (hanya untuk development)
# False = hanya izinkan origin di CORS_ALLOWED_ORIGINS (untuk production)
CORS_ALLOW_ALL_ORIGINS=False
# Origin frontend/backend yang diizinkan akses API via browser (tanpa trailing slash)
CORS_ALLOWED_ORIGINS="
http://localhost:5174,
http://localhost:8000,
https://mayaclouder.online,
https://38.180.190.211,
https://appgoldare.online,
https://www.appgoldare.online,
https://frontend.scagerwebsite.uk,
https://backend.scagerwebsite.uk,
"

# =============================================================================
# CSRF TRUSTED ORIGINS - Origin yang diizinkan kirim POST request
# =============================================================================
# Wajib untuk form/POST dari domain frontend/backend.
# Tanpa ini POST request akan ditolak dengan CSRF verification failed.
CSRF_TRUSTED_ORIGINS="
http://localhost:5174,
http://localhost:8000,
https://frontend.horizonberita.com,
https://backend.horizonberita.com,
https://appgoldare.online,
https://www.appgoldare.online,
https://frontend.scagerwebsite.uk,
https://backend.scagerwebsite.uk,
"

# =============================================================================
# ADMIN & JWT - Konfigurasi Admin Panel & Token
# =============================================================================
# URL path untuk admin Django (jangan pakai '/admin' default untuk keamanan)
ADMIN_URL=backend-admin
# Durasi JWT access token (menit)
JWT_ACCESS_MINUTES=1000
# Durasi JWT refresh token (hari)
JWT_REFRESH_DAYS=7
